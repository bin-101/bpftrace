#!/usr/bin/env bpftrace

/*
 * Simple Self Probe Demo
 * 
 * 基本的なself:signal:SIGUSR1の使用例
 */

BEGIN {
    printf("Simple self probe demo started (PID: %d)\n", pid);
    printf("To trigger the self probe, run: kill -SIGUSR1 %d\n", pid);
    @counter = 0;
}

// 何かのイベントをカウント（例：ファイルオープン）
tracepoint:syscalls:sys_enter_openat {
    @counter++;
    @files[str(args->filename)] = count();
}

// SIGUSR1を受信したときの処理
self:signal:SIGUSR1 {
    time();
    printf("=== Self probe triggered! ===\n");
    printf("Current file open count: %d\n", @counter);
    printf("Top 10 opened files:\n");
    print(@files, 10);
    printf("============================\n");
}

END {
    printf("Final count: %d\n", @counter);
    print(@files);
}
